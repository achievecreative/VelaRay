<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net11.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>WinExe</OutputType>
    <AssemblyName>VelaRay</AssemblyName>
    <RootNamespace>VelaRay.Maui</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <!-- Use the new .NET MAUI 11 Windows ItemsRepeater-based CollectionView2 handler.
         Server card selected/connected visuals are model-bound and independent
         of the native handler's selection visual states. -->
    <UseWindowsCollectionView2Handler>true</UseWindowsCollectionView2Handler>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>VelaRay</ApplicationTitle>
    <ApplicationIcon>Resources/AppIcon/velaray.ico</ApplicationIcon>
    <ApplicationId>com.velaray.client</ApplicationId>
    <ApplicationDisplayVersion>2.7.0</ApplicationDisplayVersion>
    <ApplicationVersion>7</ApplicationVersion>
    <NeutralLanguage>zh-CN</NeutralLanguage>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>
  <!-- Future Mac Catalyst target: prevent WinUI service files from compiling into it.
       Do not enable MacCatalyst until real tray/proxy/startup/process adapters exist. -->
  <ItemGroup Condition="'$(TargetPlatformIdentifier)' == 'maccatalyst'">
    <Compile Remove="Services/Windows*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="11.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="11.0.0" />
    <ProjectReference Include="../VelaRay.Core/VelaRay.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources/I18n/*.json" LogicalName="VelaRay.I18n.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <MauiIcon Include="Resources/AppIcon/appicon.png" />
    <MauiImage Include="Resources/AppIcon/velaray_logo.png" />
    <!-- Build our vector button icons as 20dp images; no fonts or external icon packages. -->
    <MauiImage Include="Resources/Images/ActionIcons/*.svg" BaseSize="20,20" />
    <EmbeddedResource Include="Resources/AppIcon/velaray.ico" LogicalName="VelaRay.Assets.velaray.ico" />
    <MauiAsset Include="Resources/Raw/**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
