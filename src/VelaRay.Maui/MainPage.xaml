<VerticalStackLayout Spacing="3"><Label Text="{Binding [FieldNewPacFilename], Source={x:Static loc:UiStrings.Instance}}" FontSize="13"/><Entry x:Name="PacNameEntry" Placeholder="{Binding [PlaceholderPacFilename], Source={x:Static loc:UiStrings.Instance}}"/></VerticalStackLayout>
