<?xml version='1.0' encoding='UTF-8'?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:models="clr-namespace:VelaRay.Core.Models;assembly=VelaRay.Core" xmlns:loc="clr-namespace:VelaRay.Maui.Localization" x:Class="VelaRay.Maui.MainPage" BackgroundColor="{AppThemeBinding Light=#F4F7FB, Dark=#101722}" Title="VelaRay">
  <Grid ColumnDefinitions="336,*" RowDefinitions="Auto,*,206" ColumnSpacing="0" RowSpacing="0">
    <!-- Top-level app bar: always available even when editing an advanced section. -->
    <Border Grid.ColumnSpan="2" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#172233}" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" StrokeThickness="1">
      <!-- Keep brand identity on the left and primary actions at the far right of the top toolbar.
           The selected editor profile and actual running profile are independent. -->
      <Grid ColumnDefinitions="Auto,*,230,150,Auto" ColumnSpacing="12" Padding="18,8">
        <Image Grid.Column="0" Source="velaray_logo.png" HeightRequest="46" WidthRequest="46" Aspect="AspectFit" SemanticProperties.Description="VelaRay logo" VerticalOptions="Center"/>
        <Label Grid.Column="1" Text="VelaRay" FontSize="23" FontAttributes="Bold" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#15263F, Dark=#F1F5F9}"/>
        <!-- Status pill reads actual runner state, never the selected editor profile. -->
        <Border Grid.Column="2" Style="{StaticResource ConnectionPillStyle}" WidthRequest="230"
                SemanticProperties.Description="{Binding [HeaderCurrentServer], Source={x:Static loc:UiStrings.Instance}}">
          <Grid ColumnDefinitions="10,*,Auto" ColumnSpacing="9" VerticalOptions="Center">
            <Border Grid.Column="0" x:Name="TopConnectionDot" HeightRequest="9" WidthRequest="9"
                    BackgroundColor="#94A3B8" StrokeThickness="0" StrokeShape="RoundRectangle 5"
                    VerticalOptions="Center"/>
            <VerticalStackLayout Grid.Column="1" Spacing="1">
              <Label Text="{Binding [HeaderCurrentServer], Source={x:Static loc:UiStrings.Instance}}"
                     FontSize="10" TextColor="{AppThemeBinding Light=#61738D, Dark=#BDD1E8}"/>
              <Label x:Name="ActiveNodeLabel" Text="—" FontAttributes="Bold" FontSize="13"
                     LineBreakMode="TailTruncation" MaxLines="1"/>
            </VerticalStackLayout>
            <Label Grid.Column="2" x:Name="TopConnectionStateLabel" Text="未连接"
                   FontSize="11" FontAttributes="Bold" VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light=#3C617B, Dark=#B5CBDD}"
                   AutomationId="connection-status-top"/>
          </Grid>
        </Border>
        <!-- Reference design: a compact globe-led segmented language control. -->
        <VerticalStackLayout Grid.Column="3" WidthRequest="150" VerticalOptions="Center" Spacing="3">
          <Border BackgroundColor="{AppThemeBinding Light=#E4EAF8, Dark=#293A53}"
                  Stroke="{AppThemeBinding Light=#D4DDEE, Dark=#435672}"
                  StrokeThickness="1" StrokeShape="RoundRectangle 24" Padding="4,3">
            <Grid ColumnDefinitions="24,*,*" ColumnSpacing="2" HeightRequest="34" VerticalOptions="Center">
              <!-- Vector globe; no font emoji or platform-specific image dependency. -->
              <Grid Grid.Column="0" WidthRequest="22" HeightRequest="22" VerticalOptions="Center" HorizontalOptions="Center">
                <Ellipse HeightRequest="17" WidthRequest="17" HorizontalOptions="Center" VerticalOptions="Center"
                         Stroke="{AppThemeBinding Light=#8290A4, Dark=#A9B9D4}" StrokeThickness="1.5" Fill="Transparent"/>
                <Ellipse HeightRequest="17" WidthRequest="8" HorizontalOptions="Center" VerticalOptions="Center"
                         Stroke="{AppThemeBinding Light=#8290A4, Dark=#A9B9D4}" StrokeThickness="1.3" Fill="Transparent"/>
                <BoxView HeightRequest="1.4" WidthRequest="17" HorizontalOptions="Center" VerticalOptions="Center"
                         Color="{AppThemeBinding Light=#8290A4, Dark=#A9B9D4}"/>
              </Grid>
              <Button x:Name="ChineseLanguageButton" Grid.Column="1" Text="中文" Clicked="ChineseLanguageClicked"
                      AutomationId="language-zh" CornerRadius="18" Padding="3,3" FontSize="14"
                      SemanticProperties.Description="切换为中文"/>
              <Button x:Name="EnglishLanguageButton" Grid.Column="2" Text="EN" Clicked="EnglishLanguageClicked"
                      AutomationId="language-en" CornerRadius="18" Padding="3,3" FontSize="14"
                      SemanticProperties.Description="Switch to English"/>
            </Grid>
          </Border>
        </VerticalStackLayout>
        <!-- Primary actions belong to the top-right toolbar, NEVER below the logo/title. -->
        <HorizontalStackLayout Grid.Column="4" VerticalOptions="Center" HorizontalOptions="End" Spacing="8">
          <Button Text="{Binding [HeaderViewConfig], Source={x:Static loc:UiStrings.Instance}}" Clicked="ViewConfigClicked"
                  Style="{StaticResource SecondaryButtonStyle}" WidthRequest="140" AutomationId="view-config" ImageSource="action_file_code_neutral.png" ContentLayout="Left,6"/>
          <Button x:Name="HeaderConnectionButton" Text="{Binding [HeaderConnect], Source={x:Static loc:UiStrings.Instance}}" Clicked="ConnectionActionClicked"
                  Style="{StaticResource PrimaryButtonStyle}" WidthRequest="156" AutomationId="connection-action-top" ImageSource="action_plug_primary.png" ContentLayout="Left,6"/>
        </HorizontalStackLayout>
      </Grid>
    </Border>
    <!-- Persistent navigation & profiles. No nested ScrollView/CollectionView. -->
    <Border Grid.Row="1" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#172233}" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" StrokeThickness="1">
      <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" Padding="16,18" RowSpacing="12">
        <Label Text="{Binding [NavWorkspace], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource EyebrowLabelStyle}"/>
        <VerticalStackLayout Grid.Row="1" Spacing="8">
          <Button x:Name="SettingsNavButton" AutomationId="nav-proxy-settings" Text="{Binding [NavProxySettings], Source={x:Static loc:UiStrings.Instance}}" Clicked="ShowSettingsClicked" Style="{StaticResource NavigationButtonStyle}" ImageSource="action_sliders_neutral.png" ContentLayout="Left,6" HandlerChanged="NavigationButtonHandlerChanged" />
          <Button x:Name="RoutingNavButton" AutomationId="nav-routing-pac" Text="{Binding [NavRoutingPac], Source={x:Static loc:UiStrings.Instance}}" Clicked="ShowRoutingClicked" Style="{StaticResource NavigationButtonStyle}" ImageSource="action_route_neutral.png" ContentLayout="Left,6" HandlerChanged="NavigationButtonHandlerChanged" />
        </VerticalStackLayout>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
          <Label Text="{Binding [NavServers], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource EyebrowLabelStyle}" VerticalOptions="Center"/>
          <Button Grid.Column="1" x:Name="MeasureLatencyButton" Text="{Binding [ActionTestTcpLatency], Source={x:Static loc:UiStrings.Instance}}"
                  Clicked="MeasureLatenciesClicked" Style="{StaticResource SmallButtonStyle}" Padding="8,5" FontSize="11"
                  SemanticProperties.Description="{Binding [HelpTestTcpLatency], Source={x:Static loc:UiStrings.Instance}}" ImageSource="action_gauge_neutral.png" ContentLayout="Left,6"/>
          <Button Grid.Column="2" Text="" Clicked="AddClicked" Style="{StaticResource SmallButtonStyle}" WidthRequest="34" HeightRequest="34" SemanticProperties.Description="{Binding [HelpAddServerTooltip], Source={x:Static loc:UiStrings.Instance}}" ImageSource="action_plus_neutral.png" ContentLayout="Left,6"/>
        </Grid>
        <!-- Selected card uses blue outline; running profile uses a separate left rail and check badge. -->
        <CollectionView x:Name="ProfilesList" Grid.Row="3" ItemSizingStrategy="MeasureAllItems" SelectionMode="Single"
                        SelectionChanged="ProfilesSelectionChanged" AutomationId="server-list">
          <!-- Let the native CollectionView layout allocate the gap BETWEEN items.
               Template margins did not produce reliable spacing in the WinUI list. -->
          <CollectionView.ItemsLayout>
            <LinearItemsLayout Orientation="Vertical" ItemSpacing="2"/>
          </CollectionView.ItemsLayout>
          <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:ServerProfile">
              <!-- Dedicated 10dp empty column OUTSIDE the server card border.
                   Actual visible clearance varies with the native scrollbar width. -->
              <Grid ColumnDefinitions="*,10" HorizontalOptions="Fill">
                <!-- CollectionView selection is applied to the template ROOT.
                     Target its child card, preserving independent connected status. -->
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroup Name="CommonStates">
                    <VisualState Name="Normal">
                      <VisualState.Setters>
                        <Setter TargetName="ProfileCardBorder" Property="Border.BackgroundColor" Value="{AppThemeBinding Light=#FFFFFF, Dark=#172233}"/>
                        <Setter TargetName="ProfileCardBorder" Property="Border.Stroke" Value="{AppThemeBinding Light=#DCE4F2, Dark=#3C4C60}"/>
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState Name="Selected">
                      <VisualState.Setters>
                        <Setter TargetName="ProfileCardBorder" Property="Border.BackgroundColor" Value="{AppThemeBinding Light=#EDF3FF, Dark=#20324D}"/>
                        <Setter TargetName="ProfileCardBorder" Property="Border.Stroke" Value="{AppThemeBinding Light=#4E68FF, Dark=#87A3FF}"/>
                      </VisualState.Setters>
                    </VisualState>
                  </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Border x:Name="ProfileCardBorder" Grid.Column="0"
                        Stroke="{AppThemeBinding Light=#DCE4F2, Dark=#3C4C60}" StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 15" Padding="0" MinimumHeightRequest="78"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#172233}">
                  <Grid ColumnDefinitions="4,*" ColumnSpacing="0">
                  <BoxView Grid.Column="0" IsVisible="{Binding IsConnected}" Color="{AppThemeBinding Light=#3152C6, Dark=#87A3FF}"/>
                  <Grid Grid.Column="1" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="9"
                        RowSpacing="6" Padding="12,11,12,11" VerticalOptions="Center">
                    <!-- Name and address share the same left edge. The connected dot sits
                         AFTER the flexible name column, so it does not indent only row one. -->
                    <Grid Grid.Row="0" Grid.Column="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" VerticalOptions="Center">
                      <Label Grid.Column="0" Text="{Binding Name}" FontSize="14" FontAttributes="Bold"
                             MaxLines="1" LineBreakMode="TailTruncation" VerticalOptions="Center"
                             HorizontalOptions="Fill" HorizontalTextAlignment="Start"
                             TextColor="{AppThemeBinding Light=#172A45, Dark=#F1F5F9}"/>
                      <Border Grid.Column="1" IsVisible="{Binding IsConnected}" VerticalOptions="Center"
                              HeightRequest="8" WidthRequest="8" BackgroundColor="#20B47B"
                              StrokeThickness="0" StrokeShape="RoundRectangle 4"/>
                      <Border Grid.Column="2" BackgroundColor="{AppThemeBinding Light=#E2E8FF, Dark=#304675}"
                              StrokeThickness="0" StrokeShape="RoundRectangle 5" Padding="5,2" VerticalOptions="Center">
                        <Label Text="{Binding ProtocolBadge}" FontSize="11" MaxLines="1"
                               TextColor="{AppThemeBinding Light=#2E50C8, Dark=#A8BDFF}"/>
                      </Border>
                    </Grid>
                    <Label Grid.Row="1" Grid.Column="0" Text="{Binding EndpointDisplay}" MaxLines="1"
                           FontFamily="{StaticResource AppCodeFontFamily}" FontSize="12"
                           LineBreakMode="MiddleTruncation" VerticalOptions="Center"
                           HorizontalOptions="Fill" HorizontalTextAlignment="Start"
                           TextColor="{AppThemeBinding Light=#63758B, Dark=#B6C7DC}"/>
                    <VerticalStackLayout Grid.RowSpan="2" Grid.Column="1" Spacing="3" HorizontalOptions="End"
                                         VerticalOptions="Center" MinimumWidthRequest="52">
                      <!-- Never invent a latency: explicit TCP test populates this value. -->
                      <Label Text="{Binding LatencyDisplay}" HorizontalTextAlignment="End" FontSize="11" TextColor="{AppThemeBinding Light=#418A6F, Dark=#8BC9A8}"/>
                      <HorizontalStackLayout IsVisible="{Binding IsConnected}" HorizontalOptions="End" Spacing="5">
                        <Border HeightRequest="16" WidthRequest="16" Stroke="#3159D6" StrokeThickness="1.7"
                                StrokeShape="RoundRectangle 8" BackgroundColor="Transparent" Padding="0">
                          <Label Text="✓" FontSize="10" TextColor="{AppThemeBinding Light=#3159D6, Dark=#9AB7FF}"
                                 HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Label Text="{Binding [ServerRunningIndicatorShort], Source={x:Static loc:UiStrings.Instance}}"
                               FontSize="11" TextColor="{AppThemeBinding Light=#3159D6, Dark=#9AB7FF}"
                               VerticalOptions="Center"/>
                      </HorizontalStackLayout>
                    </VerticalStackLayout>
                  </Grid>
                </Grid>
                </Border>
              </Grid>
            </DataTemplate>
          </CollectionView.ItemTemplate>
        </CollectionView>
        <Grid Grid.Row="4" ColumnDefinitions="*,1.6*,*" ColumnSpacing="6">
          <Button Text="{Binding [ActionClone], Source={x:Static loc:UiStrings.Instance}}" Clicked="CloneClicked" Style="{StaticResource SmallButtonStyle}" ImageSource="action_copy_neutral.png" ContentLayout="Left,6"/>
          <Button Grid.Column="1" Text="{Binding [ActionValidateConfig], Source={x:Static loc:UiStrings.Instance}}" Clicked="TestClicked" Style="{StaticResource SmallButtonStyle}" FontSize="12" ImageSource="action_check_circle_neutral.png" ContentLayout="Left,6" AutomationId="check-config-server-action"/>
          <Button x:Name="DeleteProfileButton" Grid.Column="2" Text="{Binding [ActionDelete], Source={x:Static loc:UiStrings.Instance}}" Clicked="DeleteClicked" Style="{StaticResource SmallButtonStyle}" ImageSource="action_delete_neutral.png" ContentLayout="Left,6"/>
        </Grid>
        <!-- Server editing is a distinct, node-scoped workspace at the bottom of the sidebar. -->
        <Button Grid.Row="5" x:Name="NodeNavButton" AutomationId="nav-server-settings"
                Text="{Binding [NavServerSettings], Source={x:Static loc:UiStrings.Instance}}"
                Clicked="ShowNodeClicked" Style="{StaticResource NavigationButtonStyle}"
                Margin="0,8,0,0" ImageSource="action_settings_neutral.png" ContentLayout="Left,6" HandlerChanged="NavigationButtonHandlerChanged" />
      </Grid>
    </Border>
    <!-- One active workspace section at a time; existing event contracts are preserved. -->
    <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="14" Padding="22,20,22,14">
      <VerticalStackLayout Spacing="9">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
          <VerticalStackLayout Spacing="4">
            <Label x:Name="WorkspaceTitle" Text="服务器设置" Style="{StaticResource WorkspaceTitleStyle}"/>
            <Label x:Name="WorkspaceSubtitle" Text="管理节点并配置传输层、TLS 和认证参数。" Style="{StaticResource HintLabelStyle}"/>
          </VerticalStackLayout>
          <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#E8F1FF, Dark=#223956}"
                  StrokeThickness="0" Padding="12,6" StrokeShape="RoundRectangle 16" VerticalOptions="Center">
            <Label x:Name="ConnectionStateLabel" Text="未连接" FontSize="13" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#2559A1, Dark=#9BC9FF}"/>
          </Border>
        </Grid>
        <!-- Pending configuration is intentionally never applied by changing selection or saving. -->
        <Border x:Name="PendingRoutingBanner" IsVisible="False" AutomationId="pending-core-routing"
                BackgroundColor="{AppThemeBinding Light=#FFF5E8, Dark=#473920}"
                Stroke="{AppThemeBinding Light=#EEC58E, Dark=#9E7942}" StrokeThickness="1"
                StrokeShape="RoundRectangle 10" Padding="11,7">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <Label Text="{Binding [RoutingPendingReconnectHint], Source={x:Static loc:UiStrings.Instance}}"
                   VerticalOptions="Center" LineBreakMode="WordWrap" FontSize="12"
                   TextColor="{AppThemeBinding Light=#845516, Dark=#FFDAA4}"/>
            <Button x:Name="PendingReconnectButton" Grid.Column="1" Clicked="PendingReconnectClicked"
                    Text="{Binding [ActionReconnectToApply], Source={x:Static loc:UiStrings.Instance}}"
                    Style="{StaticResource SmallButtonStyle}" AutomationId="apply-pending-routing" ImageSource="action_refresh_neutral.png" ContentLayout="Left,6"/>
          </Grid>
        </Border>
      </VerticalStackLayout>
      <Border Grid.Row="1" Style="{StaticResource SurfaceCardStyle}">
        <ScrollView AutomationId="workspace-scroll">
          <VerticalStackLayout Padding="4,4,12,16" Spacing="16">
            <VerticalStackLayout xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Name="NodeSection" Spacing="10">
<Label x:Name="RunningNodeLockNotice" IsVisible="False" Text="{Binding [RunningNodeEditLocked], Source={x:Static loc:UiStrings.Instance}}" TextColor="{AppThemeBinding Light=#945800, Dark=#F5CC8A}" FontAttributes="Bold" FontSize="13" LineBreakMode="WordWrap"/>
<VerticalStackLayout x:Name="NodeEditFields" Spacing="10">
<!-- The selected node owns this V4/V5 choice; keep it inline with the Connection heading. -->
<Grid ColumnDefinitions="*,Auto,94" ColumnSpacing="10" Margin="0,10,0,3" VerticalOptions="Center">
  <Label Grid.Column="0" Text="{Binding [SectionConnection], Source={x:Static loc:UiStrings.Instance}}" FontAttributes="Bold" FontSize="17" VerticalOptions="Center"/>
  <Label Grid.Column="1" Text="{Binding [ConfigJsonFormat], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource FieldLabelStyle}" VerticalOptions="Center"/>
  <Picker x:Name="ConfigVersionPicker" Grid.Column="2" WidthRequest="94" MinimumWidthRequest="94" HorizontalOptions="End" VerticalOptions="Center" SelectedIndexChanged="ConfigVersionChanged" AutomationId="config-format"/>
</Grid>
<Grid ColumnDefinitions="*,*" RowSpacing="8" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto,Auto">
<VerticalStackLayout Grid.Row="0" Grid.Column="0"><VerticalStackLayout Spacing="3"><Label Text="{Binding [FieldServerName], Source={x:Static loc:UiStrings.Instance}}" FontSize="13"/><Entry x:Name="NameEntry" Placeholder="{Binding [PlaceholderServerName], Source={x:Static loc:UiStrings.Instance}}"/></VerticalStackLayout></VerticalStackLayout>
<VerticalStackLayout Grid.Row="0" Grid.Column="1"><VerticalStackLayout Spacing="3"><Label Text="{Binding [FieldProtocol], Source={x:Static loc:UiStrings.Instance}}" FontSize="13"/><Picker x:Name="ProtocolPicker" SelectedIndexChanged="ProtocolChanged"/></VerticalStackLayout></VerticalStackLayout>
<VerticalStackLayout Grid.Row="1" Grid.Column="0"><VerticalStackLayout Spacing="3"><Label Text="{Binding [FieldServerAddress], Source={x:Static loc:UiStrings.Instance}}" FontSize="13"/><Entry x:Name="AddressEntry" Placeholder="{Binding [PlaceholderServerAddress], Source={x:Static loc:UiStrings.Instance}}"/></VerticalStackLayout></VerticalStackLayout>
<VerticalStackLayout Grid.Row="1" Grid.Column="1"><VerticalStackLayout Spacing="3"><Label Text="{Binding [FieldServerPort], Source={x:Static loc:UiStrings.Instance}}" FontSize="13"/><Entry x:Name="PortEntry" Keyboard="Numeric" Placeholder="{Binding [PlaceholderServerPort], Source={x:Static loc:UiStrings.Instance}}"/></VerticalStackLayout></VerticalStackLayout>
<VerticalStackLayout x:Name="VmessUuidPanel" Grid.Row="2" Grid.Column="0" Spacing="3"><Label Text="{Binding [FieldVmessUuid], Source={x:Static loc:UiStrings.Instance}}" FontSize="13"/><Entry x:Name="UuidEntry" Placeholder="{Binding [PlaceholderVmessUuid], Source={x:Static loc:UiStrings.Instance}}" AutomationId="vmess-uuid"/></VerticalStackLayout>
<VerticalStackLayout x:Name="TrojanPasswordPanel" Grid.Row="2" Grid.Column="1" Spacing="3"><Label Text="{Binding [FieldTrojanPassword], Source={x:Static loc:UiStrings.Instance}}" FontSize="13"/><Entry x:Name="PasswordEntry" Placeholder="{Binding [PlaceholderTrojanPassword], Source={x:Static loc:UiStrings.Instance}}" IsPassword="True" AutomationId="trojan-password"/></VerticalStackLayout>
<VerticalStackLayout Grid.Row="3" Grid.Column="0"><VerticalStackLayout Spacing="3"><Label Text="{Binding [FieldVmessEncryption], Source={x:Static loc:UiStrings.Instance}}" FontSize="13"/><Picker x:Name="VmessSecurityPicker" Title="{Binding [OptionEncryptionAuto], Source={x:Static loc:UiStrings.Instance}}"/></VerticalStackLayout></VerticalStackLayout>
<VerticalStackLayout Grid.Row="3" Grid.Column="1"><VerticalStackLayout Spacing="3"><Label Text="{Binding [FieldVmessAlterId], Source={x:Static loc:UiStrings.Instance}}" FontSize="13"/><Entry x:Name="VmessAlterIdEntry" Placeholder="{Binding [PlaceholderVmessAlterId], Source={x:Static loc:UiStrings.Instance}}" Keyboard="Numeric" Text="0"/></VerticalStackLayout></VerticalStackLayout>
</Grid>
<Label Text="{Binding [SectionTransportSecurity], Source={x:Static loc:UiStrings.Instance}}" FontAttributes="Bold" FontSize="17" Margin="0,10,0,3"/>
<Grid ColumnDefinitions="*,*" RowSpacing="8" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
<VerticalStackLayout Grid.Row="0" Grid.Column="0"><VerticalStackLayout Spacing="3"><Label Text="{Binding [FieldTransportType], Source={x:Static loc:UiStrings.Instance}}" FontSize="13"/><Picker x:Name="TransportPicker" SelectedIndexChanged="TransportChanged"/></VerticalStackLayout></VerticalStackLayout>
<VerticalStackLayout Grid.Row="0" Grid.Column="1"><VerticalStackLayout Spacing="3"><Label Text="{Binding [FieldTlsServerName], Source={x:Static loc:UiStrings.Instance}}" FontSize="13"/><Entry x:Name="SniEntry" Placeholder="{Binding [PlaceholderTlsServerName], Source={x:Static loc:UiStrings.Instance}}"/></VerticalStackLayout></VerticalStackLayout>
<VerticalStackLayout Grid.Row="1" Grid.Column="0"><Grid ColumnDefinitions="48,*" ColumnSpacing="4"><Switch Grid.Column="0" HorizontalOptions="Start" Scale="0.84" x:Name="TlsSwitch" Toggled="SecurityOptionsChanged"/><Label Grid.Column="1" Text="{Binding [ToggleEnableTls], Source={x:Static loc:UiStrings.Instance}}" VerticalOptions="Center"/></Grid></VerticalStackLayout>
<VerticalStackLayout Grid.Row="1" Grid.Column="1"><Grid ColumnDefinitions="48,*" ColumnSpacing="4"><Switch Grid.Column="0" HorizontalOptions="Start" Scale="0.84" x:Name="UdpSwitch"/><Label Grid.Column="1" Text="{Binding [ToggleHy2UdpExtension], Source={x:Static loc:UiStrings.Instance}}" VerticalOptions="Center"/></Grid></VerticalStackLayout>
<VerticalStackLayout Grid.Row="2" Grid.Column="0"><VerticalStackLayout Spacing="3"><Label Text="{Binding [FieldTlsAlpn], Source={x:Static loc:UiStrings.Instance}}" FontSize="13"/><Entry x:Name="AlpnEntry" Placeholder="{Binding [PlaceholderTlsAlpn], Source={x:Static loc:UiStrings.Instance}}"/></VerticalStackLayout></VerticalStackLayout>
<VerticalStackLayout Grid.Row="2" Grid.Column="1"><VerticalStackLayout Spacing="3"><Label Text="{Binding [FieldPinnedCertificate], Source={x:Static loc:UiStrings.Instance}}" FontSize="13"/><Entry x:Name="PinEntry" Placeholder="{Binding [PlaceholderPinnedCertificate], Source={x:Static loc:UiStrings.Instance}}"/></VerticalStackLayout></VerticalStackLayout>
<VerticalStackLayout Grid.Row="3" Grid.Column="0"><VerticalStackLayout Spacing="3"><Label Text="{Binding [FieldHy2Password], Source={x:Static loc:UiStrings.Instance}}" FontSize="13"/><Entry x:Name="Hy2PasswordEntry" Placeholder="{Binding [PlaceholderHy2Password], Source={x:Static loc:UiStrings.Instance}}" IsPassword="True"/></VerticalStackLayout></VerticalStackLayout>
<VerticalStackLayout Grid.Row="3" Grid.Column="1"><VerticalStackLayout Spacing="3"><Label Text="{Binding [FieldHy2Congestion], Source={x:Static loc:UiStrings.Instance}}" FontSize="13"/><Picker x:Name="CongestionPicker" SelectedIndexChanged="SecurityOptionsChanged"/></VerticalStackLayout></VerticalStackLayout>
<VerticalStackLayout Grid.Row="4" Grid.Column="0"><VerticalStackLayout Spacing="3"><Label Text="{Binding [FieldBrutalUploadMbps], Source={x:Static loc:UiStrings.Instance}}" FontSize="13"/><Entry x:Name="UploadEntry" Keyboard="Numeric" Placeholder="{Binding [PlaceholderBrutalUpload], Source={x:Static loc:UiStrings.Instance}}"/></VerticalStackLayout></VerticalStackLayout>
<VerticalStackLayout Grid.Row="4" Grid.Column="1"><VerticalStackLayout Spacing="3"><Label Text="{Binding [FieldBrutalDownloadMbps], Source={x:Static loc:UiStrings.Instance}}" FontSize="13"/><Entry x:Name="DownloadEntry" Keyboard="Numeric" Placeholder="{Binding [PlaceholderBrutalDownload], Source={x:Static loc:UiStrings.Instance}}"/></VerticalStackLayout></VerticalStackLayout>
</Grid>
<VerticalStackLayout Spacing="4" x:Name="AllowInsecurePanel">
  <Grid ColumnDefinitions="48,*" ColumnSpacing="4"><Switch Grid.Column="0" HorizontalOptions="Start" Scale="0.84" x:Name="AllowInsecureSwitch" AutomationId="allow-insecure-v4"/><Label Grid.Column="1" Text="{Binding [ToggleAllowInsecureTls], Source={x:Static loc:UiStrings.Instance}}" VerticalOptions="Center" TextColor="#C76649"/></Grid>
  <Label Text="{Binding [HelpAllowInsecureTls], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource HintLabelStyle}"/>
</VerticalStackLayout>
<Border x:Name="TransportDetailsPanel" Style="{StaticResource InnerCardStyle}">
  <VerticalStackLayout Spacing="10">
    <Label x:Name="TransportDetailsTitle" Text="{Binding [SectionTransportParameters], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource SectionTitleStyle}"/>
    <Label x:Name="TransportDetailsHint" Text="{Binding [HelpTransportParameters], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource HintLabelStyle}"/>
    <VerticalStackLayout x:Name="WebSocketPanel" Spacing="10">
      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
        <VerticalStackLayout Grid.Column="0" Spacing="4"><Label Text="{Binding [FieldWebSocketPath], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource FieldLabelStyle}"/><Entry x:Name="WsPathEntry" Placeholder="{Binding [ExampleRootPath], Source={x:Static loc:UiStrings.Instance}}"/></VerticalStackLayout>
        <VerticalStackLayout Grid.Column="1" Spacing="4"><Label Text="{Binding [FieldWebSocketHeaders], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource FieldLabelStyle}"/><Editor x:Name="WsHeadersEntry" HeightRequest="76" AutoSize="Disabled" Placeholder="{}{}"/></VerticalStackLayout>
      </Grid>
    </VerticalStackLayout>
    <VerticalStackLayout x:Name="GrpcPanel" Spacing="6">
      <Label Text="{Binding [FieldGrpcServiceName], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource FieldLabelStyle}"/>
      <Entry x:Name="GrpcEntry" Placeholder="{Binding [ExampleGrpcService], Source={x:Static loc:UiStrings.Instance}}"/>
    </VerticalStackLayout>
    <VerticalStackLayout x:Name="HttpUpgradePanel" Spacing="10">
      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
        <VerticalStackLayout Grid.Column="0" Spacing="4"><Label Text="{Binding [FieldHttpUpgradePath], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource FieldLabelStyle}"/><Entry x:Name="Http2PathEntry" Placeholder="{Binding [ExampleRootPath], Source={x:Static loc:UiStrings.Instance}}"/></VerticalStackLayout>
        <VerticalStackLayout Grid.Column="1" Spacing="4"><Label Text="{Binding [FieldHttpUpgradeHost], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource FieldLabelStyle}"/><Entry x:Name="Http2HostsEntry" Placeholder="{Binding [ExampleServerDomain], Source={x:Static loc:UiStrings.Instance}}"/></VerticalStackLayout>
      </Grid>
    </VerticalStackLayout>
    <VerticalStackLayout x:Name="TcpPanel" Spacing="6">
      <Label Text="{Binding [FieldTcpHeader], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource FieldLabelStyle}"/>
      <Editor x:Name="TcpHeaderEntry" HeightRequest="76" AutoSize="Disabled" Placeholder="{}{&quot;type&quot;:&quot;none&quot;}"/>
    </VerticalStackLayout>
    <VerticalStackLayout x:Name="KcpTransportPanel" Spacing="9">
      <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto,Auto">
