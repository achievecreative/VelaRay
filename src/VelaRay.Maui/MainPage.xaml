        <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="4"><Label Text="{Binding [FieldKcpTti], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource FieldLabelStyle}"/><Entry x:Name="KcpTtiEntry" Placeholder="{Binding [PlaceholderKcpTti], Source={x:Static loc:UiStrings.Instance}}" Keyboard="Numeric"/></VerticalStackLayout>
        <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="4"><Label Text="{Binding [FieldKcpUplinkCapacity], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource FieldLabelStyle}"/><Entry x:Name="KcpUplinkEntry" Placeholder="{Binding [PlaceholderKcpUplink], Source={x:Static loc:UiStrings.Instance}}" Keyboard="Numeric"/></VerticalStackLayout>
        <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="4"><Label Text="{Binding [FieldKcpDownlinkCapacity], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource FieldLabelStyle}"/><Entry x:Name="KcpDownlinkEntry" Placeholder="{Binding [PlaceholderKcpDownlink], Source={x:Static loc:UiStrings.Instance}}" Keyboard="Numeric"/></VerticalStackLayout>
        <VerticalStackLayout Grid.Row="2" Grid.Column="0" Spacing="4"><Label Text="{Binding [FieldKcpReceiveBuffer], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource FieldLabelStyle}"/><Entry x:Name="KcpReadEntry" Placeholder="{Binding [PlaceholderKcpReceiveBuffer], Source={x:Static loc:UiStrings.Instance}}" Keyboard="Numeric"/></VerticalStackLayout>
        <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="4"><Label Text="{Binding [FieldKcpSendBuffer], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource FieldLabelStyle}"/><Entry x:Name="KcpWriteEntry" Placeholder="{Binding [PlaceholderKcpSendBuffer], Source={x:Static loc:UiStrings.Instance}}" Keyboard="Numeric"/></VerticalStackLayout>
        <VerticalStackLayout Grid.Row="3" Grid.Column="0" Spacing="4"><Label Text="{Binding [FieldKcpHeader], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource FieldLabelStyle}"/><Entry x:Name="KcpHeaderEntry" Placeholder="{Binding [PlaceholderKcpHeader], Source={x:Static loc:UiStrings.Instance}}"/></VerticalStackLayout>
        <VerticalStackLayout Grid.Row="3" Grid.Column="1" Spacing="4"><Grid ColumnDefinitions="48,*" ColumnSpacing="4"><Switch x:Name="KcpCongestionSwitch" Grid.Column="0" Scale="0.84" HorizontalOptions="Start"/><Label Grid.Column="1" Text="{Binding [ToggleKcpCongestion], Source={x:Static loc:UiStrings.Instance}}" VerticalOptions="Center"/></Grid></VerticalStackLayout>
      </Grid>
    </VerticalStackLayout>
    <VerticalStackLayout x:Name="QuicTransportPanel" Spacing="9">
      <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto">
        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4"><Label Text="{Binding [FieldQuicSecurity], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource FieldLabelStyle}"/><Entry x:Name="QuicSecurityEntry" Placeholder="{Binding [PlaceholderQuicSecurity], Source={x:Static loc:UiStrings.Instance}}"/></VerticalStackLayout>
        <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="4"><Label Text="{Binding [FieldQuicKey], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource FieldLabelStyle}"/><Entry x:Name="QuicKeyEntry" Placeholder="{Binding [PlaceholderQuicKey], Source={x:Static loc:UiStrings.Instance}}"/></VerticalStackLayout>
        <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="4"><Label Text="{Binding [FieldQuicHeader], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource FieldLabelStyle}"/><Entry x:Name="QuicHeaderEntry" Placeholder="{Binding [PlaceholderQuicHeader], Source={x:Static loc:UiStrings.Instance}}"/></VerticalStackLayout>
      </Grid>
