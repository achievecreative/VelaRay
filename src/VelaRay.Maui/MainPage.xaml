</VerticalStackLayout>
<FlexLayout Direction="Row" Wrap="Wrap" AlignItems="Center"><Button Margin="0,0,8,8" x:Name="SaveProfileButton" Text="{Binding [ActionSaveServer], Source={x:Static loc:UiStrings.Instance}}" Clicked="SaveClicked" ImageSource="action_save_neutral.png" ContentLayout="Left,6"/><Button Margin="0,0,8,8" Text="{Binding [ActionApplyServer], Source={x:Static loc:UiStrings.Instance}}" Clicked="ApplyClicked" ImageSource="action_plug_neutral.png" ContentLayout="Left,6"/></FlexLayout>
</VerticalStackLayout>

            <VerticalStackLayout xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Name="SettingsSection" Spacing="10" IsVisible="False">
<!-- Workstation-level settings, organised without changing any persisted field or core behavior. -->
<Border Style="{StaticResource GlobalScopeCardStyle}">
  <VerticalStackLayout Spacing="4">
    <Label Text="{Binding [GlobalScopeLabel], Source={x:Static loc:UiStrings.Instance}}"
           FontAttributes="Bold" FontSize="14" TextColor="{AppThemeBinding Light=#20559A, Dark=#A5CBFF}"/>
    <Label Text="{Binding [HelpProxySettingsShared], Source={x:Static loc:UiStrings.Instance}}"
           Style="{StaticResource HintLabelStyle}"/>
  </VerticalStackLayout>
</Border>

<!-- Choice cards only mirror the original ProxyModePicker: PAC / Global / Manual. -->
<Border Style="{StaticResource SurfaceCardStyle}">
  <VerticalStackLayout Spacing="13">
    <Label Text="{Binding [FieldSystemProxyMode], Source={x:Static loc:UiStrings.Instance}}"
           Style="{StaticResource SectionTitleStyle}"/>
    <Label Text="{Binding [HelpProxyModeCards], Source={x:Static loc:UiStrings.Instance}}"
           Style="{StaticResource HintLabelStyle}"/>
    <!-- Keep existing picker as the single source for selection, saving and connection logic. -->
    <Picker x:Name="ProxyModePicker" IsVisible="False" SelectedIndexChanged="ProxyModeChanged"/>
    <!-- Responsive grid: three cards on wide windows, two or one when space is limited.
         Change grid positions only; keep the original picker and card handlers intact. -->
    <Grid x:Name="ProxyModeCardsGrid" ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto"
          ColumnSpacing="10" RowSpacing="10" HorizontalOptions="Fill"
          SizeChanged="ProxyModeCardsGridSizeChanged" AutomationId="proxy-mode-responsive-grid">
      <Border x:Name="PacProxyModeCard" Grid.Column="0" Grid.Row="0"
              Style="{StaticResource ProxyModeChoiceCardStyle}" AutomationId="mode-card-pac">
        <Border.GestureRecognizers><TapGestureRecognizer Tapped="PacProxyModeCardTapped"/></Border.GestureRecognizers>
        <VerticalStackLayout Spacing="7">
          <Grid ColumnDefinitions="30,*" ColumnSpacing="6">
            <RadioButton x:Name="PacProxyModeRadio" Grid.Column="0" Value="PAC" GroupName="SystemProxyMode"
                         Content="" SemanticProperties.Description="{Binding [ProxyModePacTitle], Source={x:Static loc:UiStrings.Instance}}"
                         CheckedChanged="ProxyModeCardCheckedChanged" HorizontalOptions="Start" VerticalOptions="Start"/>
            <Label Grid.Column="1" Text="{Binding [ProxyModePacTitle], Source={x:Static loc:UiStrings.Instance}}"
                   FontAttributes="Bold" FontSize="13" LineBreakMode="WordWrap" VerticalOptions="Center"/>
          </Grid>
          <Label Text="{Binding [ProxyModePacDescription], Source={x:Static loc:UiStrings.Instance}}"
                 Style="{StaticResource HintLabelStyle}" LineBreakMode="WordWrap"/>
        </VerticalStackLayout>
      </Border>
      <Border x:Name="GlobalProxyModeCard" Grid.Column="1" Grid.Row="0"
              Style="{StaticResource ProxyModeChoiceCardStyle}" AutomationId="mode-card-global">
        <Border.GestureRecognizers><TapGestureRecognizer Tapped="GlobalProxyModeCardTapped"/></Border.GestureRecognizers>
        <VerticalStackLayout Spacing="7">
          <Grid ColumnDefinitions="30,*" ColumnSpacing="6">
            <RadioButton x:Name="GlobalProxyModeRadio" Grid.Column="0" Value="Global" GroupName="SystemProxyMode"
                         Content="" SemanticProperties.Description="{Binding [ProxyModeGlobalTitle], Source={x:Static loc:UiStrings.Instance}}"
                         CheckedChanged="ProxyModeCardCheckedChanged" HorizontalOptions="Start" VerticalOptions="Start"/>
            <Label Grid.Column="1" Text="{Binding [ProxyModeGlobalTitle], Source={x:Static loc:UiStrings.Instance}}"
                   FontAttributes="Bold" FontSize="13" LineBreakMode="WordWrap" VerticalOptions="Center"/>
          </Grid>
          <Label Text="{Binding [ProxyModeGlobalDescription], Source={x:Static loc:UiStrings.Instance}}"
                 Style="{StaticResource HintLabelStyle}" LineBreakMode="WordWrap"/>
        </VerticalStackLayout>
      </Border>
      <Border x:Name="ManualProxyModeCard" Grid.Column="2" Grid.Row="0"
              Style="{StaticResource ProxyModeChoiceCardStyle}" AutomationId="mode-card-manual">
        <Border.GestureRecognizers><TapGestureRecognizer Tapped="ManualProxyModeCardTapped"/></Border.GestureRecognizers>
        <VerticalStackLayout Spacing="7">
          <Grid ColumnDefinitions="30,*" ColumnSpacing="6">
            <RadioButton x:Name="ManualProxyModeRadio" Grid.Column="0" Value="Manual" GroupName="SystemProxyMode"
                         Content="" SemanticProperties.Description="{Binding [ProxyModeManualTitle], Source={x:Static loc:UiStrings.Instance}}"
                         CheckedChanged="ProxyModeCardCheckedChanged" HorizontalOptions="Start" VerticalOptions="Start"/>
            <Label Grid.Column="1" Text="{Binding [ProxyModeManualTitle], Source={x:Static loc:UiStrings.Instance}}"
                   FontAttributes="Bold" FontSize="13" LineBreakMode="WordWrap" VerticalOptions="Center"/>
          </Grid>
          <Label Text="{Binding [ProxyModeManualDescription], Source={x:Static loc:UiStrings.Instance}}"
                 Style="{StaticResource HintLabelStyle}" LineBreakMode="WordWrap"/>
        </VerticalStackLayout>
      </Border>
    </Grid>
    <Label x:Name="ProxyModeDescriptionLabel" Style="{StaticResource HintLabelStyle}"/>
  </VerticalStackLayout>
</Border>

<!-- Related port fields are side by side and retain original names and switches. -->
<Border Style="{StaticResource SurfaceCardStyle}">
  <VerticalStackLayout Spacing="14">
    <Label Text="{Binding [SectionLocalProxy], Source={x:Static loc:UiStrings.Instance}}"
           Style="{StaticResource SectionTitleStyle}"/>
    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="12">
      <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource InnerCardStyle}">
        <VerticalStackLayout Spacing="9">
          <Label Text="{Binding [ProxyInboundHttpTitle], Source={x:Static loc:UiStrings.Instance}}"
                 FontAttributes="Bold" FontSize="14"/>
          <Label Text="{Binding [FieldHttpPort], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource FieldLabelStyle}"/>
          <Entry x:Name="HttpPortEntry" Keyboard="Numeric" Placeholder="{Binding [PlaceholderHttpPort], Source={x:Static loc:UiStrings.Instance}}"/>
          <Label Text="{Binding [ProxyInboundHttpDescription], Source={x:Static loc:UiStrings.Instance}}"
                 Style="{StaticResource HintLabelStyle}"/>
        </VerticalStackLayout>
      </Border>
      <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource InnerCardStyle}">
        <VerticalStackLayout Spacing="9">
          <Label Text="{Binding [ProxyInboundSocksTitle], Source={x:Static loc:UiStrings.Instance}}"
                 FontAttributes="Bold" FontSize="14"/>
          <Label Text="{Binding [FieldSocksPort], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource FieldLabelStyle}"/>
          <Entry x:Name="SocksPortEntry" Keyboard="Numeric" Placeholder="{Binding [PlaceholderSocksPort], Source={x:Static loc:UiStrings.Instance}}"/>
          <Grid ColumnDefinitions="48,*" ColumnSpacing="5">
            <Switch Grid.Column="0" x:Name="EnableUdpSwitch" Scale="0.84" HorizontalOptions="Start"/>
            <Label Grid.Column="1" Text="{Binding [ToggleSocksUdp], Source={x:Static loc:UiStrings.Instance}}" VerticalOptions="Center"/>
          </Grid>
        </VerticalStackLayout>
      </Border>
      <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource InnerCardStyle}">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
          <VerticalStackLayout Grid.Column="0" Spacing="5">
            <Label Text="{Binding [FieldPacPort], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource FieldLabelStyle}"/>
            <Entry x:Name="PacPortEntry" Keyboard="Numeric" Placeholder="{Binding [PlaceholderPacPort], Source={x:Static loc:UiStrings.Instance}}"/>
          </VerticalStackLayout>
          <VerticalStackLayout Grid.Column="1" Spacing="8">
            <Grid ColumnDefinitions="48,*" ColumnSpacing="5">
              <Switch Grid.Column="0" x:Name="LanSwitch" Scale="0.84" HorizontalOptions="Start"/>
              <Label Grid.Column="1" Text="{Binding [ToggleAllowLan], Source={x:Static loc:UiStrings.Instance}}" VerticalOptions="Center"/>
            </Grid>
            <Label Text="{Binding [HelpRestoreWindowsProxy], Source={x:Static loc:UiStrings.Instance}}"
                   Style="{StaticResource HintLabelStyle}"/>
          </VerticalStackLayout>
        </Grid>
      </Border>
    </Grid>
  </VerticalStackLayout>
</Border>

<Border Style="{StaticResource SurfaceCardStyle}">
  <VerticalStackLayout Spacing="13">
    <Label Text="{Binding [ProxyAdditionalSettingsTitle], Source={x:Static loc:UiStrings.Instance}}"
           Style="{StaticResource SectionTitleStyle}"/>
    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="12" ColumnSpacing="12">
      <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="5">
        <Label Text="{Binding [FieldCoreRoutingMode], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource FieldLabelStyle}"/>
        <Picker x:Name="RoutingModePicker" SelectedIndexChanged="RoutingModeChanged"/>
      </VerticalStackLayout>
      <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="5">
        <Label Text="{Binding [FieldLogLevel], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource FieldLabelStyle}"/>
        <Picker x:Name="LogLevelPicker"/>
      </VerticalStackLayout>
      <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="5">
        <Label Text="{Binding [FieldDnsServers], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource FieldLabelStyle}"/>
        <Entry x:Name="DnsEntry" Placeholder="{Binding [PlaceholderDnsServers], Source={x:Static loc:UiStrings.Instance}}"/>
      </VerticalStackLayout>
      <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="5">
        <Label Text="{Binding [FieldCoreExecutablePath], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource FieldLabelStyle}"/>
        <Entry x:Name="CorePathEntry" TextChanged="CorePathChanged"
               Placeholder="{Binding [PlaceholderCorePath], Source={x:Static loc:UiStrings.Instance}}"/>
      </VerticalStackLayout>
    </Grid>
    <VerticalStackLayout x:Name="ActiveRoutingRuleSettingsPanel" Spacing="6" IsVisible="False">
      <Label Text="{Binding [FieldAppliedRoutingRuleSet], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource FieldLabelStyle}"/>
      <FlexLayout Direction="Row" Wrap="Wrap" AlignItems="Center" JustifyContent="Start">
        <Picker x:Name="ActiveRoutingRulePicker" WidthRequest="280" ItemDisplayBinding="{Binding Name}" HorizontalOptions="Start" AutomationId="applied-routing-ruleset"/>
        <Button Text="{Binding [ActionApplyRoutingRuleSet], Source={x:Static loc:UiStrings.Instance}}" Clicked="ApplyActiveRoutingRuleClicked" Margin="8,0,0,0" Style="{StaticResource SmallButtonStyle}" ImageSource="action_check_neutral.png" ContentLayout="Left,6" AutomationId="apply-routing-ruleset"/>
      </FlexLayout>
      <Label x:Name="ActiveRoutingRuleStatusLabel" Style="{StaticResource HintLabelStyle}" LineBreakMode="WordWrap"/>
      <Label Text="{Binding [HelpApplyRoutingRuleSet], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource HintLabelStyle}"/>
    </VerticalStackLayout>
    <VerticalStackLayout x:Name="SmartFallbackSettingsPanel" Spacing="5">
      <Label Text="{Binding [FieldSmartUnmatchedRoute], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource FieldLabelStyle}"/>
      <Picker x:Name="SmartFallbackPicker" SelectedIndexChanged="SmartFallbackChanged" AutomationId="smart-unmatched-settings"/>
      <Label Text="{Binding [HelpSmartUnmatchedRoute], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource HintLabelStyle}"/>
    </VerticalStackLayout>
    <FlexLayout Direction="Row" Wrap="Wrap" AlignItems="Center">
      <Grid ColumnDefinitions="48,Auto" Margin="0,0,18,9" ColumnSpacing="5">
        <Switch Grid.Column="0" x:Name="SniffSwitch" Scale="0.84" HorizontalOptions="Start"/>
        <Label Grid.Column="1" Text="{Binding [ToggleTrafficSniffing], Source={x:Static loc:UiStrings.Instance}}" VerticalOptions="Center"/>
      </Grid>
      <Grid ColumnDefinitions="48,Auto" Margin="0,0,18,9" ColumnSpacing="5">
        <Switch Grid.Column="0" x:Name="StartupSwitch" Scale="0.84" HorizontalOptions="Start"/>
        <Label Grid.Column="1" Text="{Binding [ToggleStartWithWindows], Source={x:Static loc:UiStrings.Instance}}" VerticalOptions="Center"/>
      </Grid>
      <Grid ColumnDefinitions="48,Auto" Margin="0,0,18,9" ColumnSpacing="5">
        <Switch Grid.Column="0" x:Name="AutoConnectSwitch" Scale="0.84" HorizontalOptions="Start"/>
        <Label Grid.Column="1" Text="{Binding [ToggleConnectOnStartup], Source={x:Static loc:UiStrings.Instance}}" VerticalOptions="Center"/>
      </Grid>
      <Grid ColumnDefinitions="48,Auto" Margin="0,0,18,9" ColumnSpacing="5">
        <Switch Grid.Column="0" x:Name="TraySwitch" Scale="0.84" HorizontalOptions="Start"/>
        <Label Grid.Column="1" Text="{Binding [ToggleMinimizeToTray], Source={x:Static loc:UiStrings.Instance}}" VerticalOptions="Center"/>
      </Grid>
      <Grid ColumnDefinitions="48,Auto" Margin="0,0,18,9" ColumnSpacing="5">
        <Switch Grid.Column="0" x:Name="BalanceSwitch" Scale="0.84" HorizontalOptions="Start"/>
        <Label Grid.Column="1" Text="{Binding [ToggleBalanceServers], Source={x:Static loc:UiStrings.Instance}}" VerticalOptions="Center"/>
      </Grid>
    </FlexLayout>
  </VerticalStackLayout>
</Border>
<FlexLayout Direction="Row" Wrap="Wrap" AlignItems="Center">
  <Button Margin="0,0,8,8" Text="{Binding [ActionSaveSettings], Source={x:Static loc:UiStrings.Instance}}" Clicked="SaveClicked" ImageSource="action_save_neutral.png" ContentLayout="Left,6"/>
  <Button Margin="0,0,8,8" Text="{Binding [ActionViewGeneratedConfig], Source={x:Static loc:UiStrings.Instance}}" Clicked="PreviewConfigClicked" ImageSource="action_file_code_neutral.png" ContentLayout="Left,6"/>
  <Button Margin="0,0,8,8" Text="{Binding [ActionExportJson], Source={x:Static loc:UiStrings.Instance}}" Clicked="ExportClicked" ImageSource="action_download_neutral.png" ContentLayout="Left,6"/>
  <Button Margin="0,0,8,8" Text="{Binding [ActionOpenDataFolder], Source={x:Static loc:UiStrings.Instance}}" Clicked="OpenDataClicked" ImageSource="action_folder_open_neutral.png" ContentLayout="Left,6"/>
</FlexLayout>
<Border Style="{StaticResource InnerCardStyle}">
  <VerticalStackLayout Spacing="9">
    <Label Text="{Binding [SectionCoreUpdates], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource SectionTitleStyle}"/>
    <Label x:Name="CurrentCoreVersionLabel" Text="当前内核：尚未检查" Style="{StaticResource HintLabelStyle}"/>
    <Label x:Name="LatestCoreVersionLabel" Text="最新稳定版：尚未检查" Style="{StaticResource HintLabelStyle}"/>
    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
      <Switch x:Name="IncludePrereleaseCoreSwitch" Scale="0.8" VerticalOptions="Center" Toggled="CorePrereleaseToggled" AutomationId="core-include-prerelease"/>
      <Label Text="{Binding [ToggleCorePrerelease], Source={x:Static loc:UiStrings.Instance}}" VerticalOptions="Center"/>
    </HorizontalStackLayout>
    <FlexLayout Direction="Row" Wrap="Wrap" AlignItems="Center">
      <Button x:Name="CheckCoreUpdateButton" Margin="0,0,8,6" Text="{Binding [ActionCheckCoreUpdates], Source={x:Static loc:UiStrings.Instance}}" Clicked="CheckCoreUpdatesClicked" Style="{StaticResource SecondaryButtonStyle}" AutomationId="core-update-check" ImageSource="action_search_neutral.png" ContentLayout="Left,6"/>
      <Button x:Name="InstallCoreUpdateButton" Margin="0,0,8,6" Text="{Binding [ActionInstallCoreUpdate], Source={x:Static loc:UiStrings.Instance}}" Clicked="InstallCoreUpdateClicked" Style="{StaticResource PrimaryButtonStyle}" AutomationId="core-update-install" IsEnabled="False" ImageSource="action_download_primary.png" ContentLayout="Left,6"/>
    </FlexLayout>
    <Label x:Name="CoreUpdateStatusLabel" Text="{Binding [CoreUpdateDescription], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource HintLabelStyle}" LineBreakMode="WordWrap"/>
  </VerticalStackLayout>
</Border>
<HorizontalStackLayout Spacing="8">
  <Button Text="{Binding [ActionClearLogs], Source={x:Static loc:UiStrings.Instance}}" Clicked="ClearLogClicked" Style="{StaticResource SmallButtonStyle}" ImageSource="action_delete_neutral.png" ContentLayout="Left,6"/>
  <Button Text="{Binding [ActionExportLogs], Source={x:Static loc:UiStrings.Instance}}" Clicked="ExportLogClicked" Style="{StaticResource SmallButtonStyle}" ImageSource="action_download_neutral.png" ContentLayout="Left,6"/>
</HorizontalStackLayout>
</VerticalStackLayout>

            <VerticalStackLayout xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Name="RoutingSection" Spacing="10" IsVisible="False">
<Border Style="{StaticResource GlobalScopeCardStyle}">
 <VerticalStackLayout Spacing="4">
  <Label Text="{Binding [GlobalScopeLabel], Source={x:Static loc:UiStrings.Instance}}" FontAttributes="Bold" FontSize="15" TextColor="{AppThemeBinding Light=#20559A, Dark=#A5CBFF}"/>
  <Label Text="{Binding [HelpRoutingSettingsShared], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource HintLabelStyle}"/>
 </VerticalStackLayout>
