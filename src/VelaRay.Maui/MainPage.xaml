<Label Text="{Binding [SectionPacScript], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource SectionTitleStyle}"/>
<Editor x:Name="PacScriptEditor" Placeholder="{Binding [PlaceholderPacScript], Source={x:Static loc:UiStrings.Instance}}" HeightRequest="200" FontSize="13"/>
<FlexLayout Direction="Row" Wrap="Wrap" AlignItems="Center"><Button Margin="0,0,8,8" Text="{Binding [ActionNewPac], Source={x:Static loc:UiStrings.Instance}}" Clicked="AddPacClicked" ImageSource="action_plus_neutral.png" ContentLayout="Left,6"/><Button Margin="0,0,8,8" Text="{Binding [ActionSavePac], Source={x:Static loc:UiStrings.Instance}}" Clicked="SavePacClicked" ImageSource="action_save_neutral.png" ContentLayout="Left,6"/><Button Margin="0,0,8,8" Text="{Binding [ActionRefreshPac], Source={x:Static loc:UiStrings.Instance}}" Clicked="RefreshPacClicked" ImageSource="action_refresh_neutral.png" ContentLayout="Left,6"/></FlexLayout>
<Border Style="{StaticResource InnerCardStyle}">
  <VerticalStackLayout Spacing="9">
    <Label Text="{Binding [SectionGeoData], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource SectionTitleStyle}"/>
    <Label Text="{Binding [HelpGeoDataScope], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource HintLabelStyle}"/>
    <Label Text="{Binding [HelpBypassChinaRules], Source={x:Static loc:UiStrings.Instance}}" FontSize="13"/>
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <VerticalStackLayout Spacing="4">
        <Label Text="{Binding [FieldGeoIpDataset], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource FieldLabelStyle}"/>
        <Picker x:Name="GeoIpFilePicker" MinimumWidthRequest="230" HorizontalOptions="Fill" AutomationId="geoip-file"/>
      </VerticalStackLayout>
      <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="End">
        <Button Text="{Binding [ActionCheckGeoData], Source={x:Static loc:UiStrings.Instance}}" Clicked="CheckGeoAssetsClicked" Style="{StaticResource SecondaryButtonStyle}" ImageSource="action_search_neutral.png" ContentLayout="Left,6"/>
        <Button Text="{Binding [ActionUpdateGeoData], Source={x:Static loc:UiStrings.Instance}}" Clicked="UpdateGeoAssetsClicked" Style="{StaticResource SecondaryButtonStyle}" ImageSource="action_download_neutral.png" ContentLayout="Left,6"/>
      </HorizontalStackLayout>
    </Grid>
    <Label x:Name="GeoAssetsStatusLabel" Style="{StaticResource HintLabelStyle}" Text="Geo 文件位于 v2ray-core/，由 V2Fly 内核读取。"/>
  </VerticalStackLayout>
</Border>
<Label Text="{Binding [SectionAdvancedRouting], Source={x:Static loc:UiStrings.Instance}}" FontAttributes="Bold" FontSize="17" Margin="0,10,0,3"/>
<Border Style="{StaticResource InnerCardStyle}">
  <VerticalStackLayout Spacing="12">
    <!-- Route policy is selected in Proxy settings; this page only views and edits rule definitions. -->
    <Grid ColumnDefinitions="*,232" ColumnSpacing="12">
      <VerticalStackLayout Spacing="4">
        <Label Text="{Binding [RoutingStep1], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource SectionTitleStyle}"/>
        <Label Text="{Binding [HelpVisualRouting], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource HintLabelStyle}"/>
      </VerticalStackLayout>
      <VerticalStackLayout Grid.Column="1" Spacing="4">
        <Label Text="{Binding [FieldCoreRoutingMode], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource FieldLabelStyle}"/>
        <Label x:Name="RouteModeReadOnlyLabel" FontSize="13" HorizontalOptions="End" VerticalOptions="Center" AutomationId="route-mode-readonly"/>
      </VerticalStackLayout>
    </Grid>
    <VerticalStackLayout x:Name="SmartFallbackRoutingPanel" Spacing="5" IsVisible="True">
      <Label Text="{Binding [FieldSmartUnmatchedRoute], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource FieldLabelStyle}"/>
      <Label x:Name="SmartFallbackReadOnlyLabel" FontSize="13" AutomationId="smart-unmatched-readonly"/>
      <Label Text="{Binding [HelpSmartUnmatchedRoute], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource HintLabelStyle}"/>
    </VerticalStackLayout>
    <!-- All four built-in routing policies are always visible and strictly read-only.
         Browsing here does not change the active routing mode or apply a configuration. -->
    <Border x:Name="BuiltInRoutePreview" IsVisible="True"
            Stroke="{AppThemeBinding Light=#DCE7F3, Dark=#38516F}"
            StrokeThickness="1" Padding="14" StrokeShape="RoundRectangle 10">
      <VerticalStackLayout Spacing="10">
        <Label Text="{Binding [RoutingBuiltInAllTitle], Source={x:Static loc:UiStrings.Instance}}"
               Style="{StaticResource SectionTitleStyle}"/>
        <Label Text="{Binding [RoutingBuiltInAllHelp], Source={x:Static loc:UiStrings.Instance}}"
               Style="{StaticResource HintLabelStyle}" LineBreakMode="WordWrap"/>
        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
          <Border Grid.Row="0" Grid.Column="0" Padding="12" StrokeShape="RoundRectangle 9"
                  Stroke="{AppThemeBinding Light=#DBE5F1, Dark=#40516B}" StrokeThickness="1">
            <VerticalStackLayout Spacing="5">
              <Label Text="{Binding [RoutingBuiltInSmartTitle], Source={x:Static loc:UiStrings.Instance}}" FontAttributes="Bold" FontSize="13"/>
              <Label x:Name="BuiltInSmartRuleSummary" FontSize="12" LineBreakMode="WordWrap"/>
            </VerticalStackLayout>
          </Border>
          <Border Grid.Row="0" Grid.Column="1" Padding="12" StrokeShape="RoundRectangle 9"
                  Stroke="{AppThemeBinding Light=#DBE5F1, Dark=#40516B}" StrokeThickness="1">
            <VerticalStackLayout Spacing="5">
              <Label Text="{Binding [RoutingBuiltInProxyAllTitle], Source={x:Static loc:UiStrings.Instance}}" FontAttributes="Bold" FontSize="13"/>
              <Label x:Name="BuiltInProxyAllRuleSummary" FontSize="12" LineBreakMode="WordWrap"/>
            </VerticalStackLayout>
          </Border>
          <Border Grid.Row="1" Grid.Column="0" Padding="12" StrokeShape="RoundRectangle 9"
                  Stroke="{AppThemeBinding Light=#DBE5F1, Dark=#40516B}" StrokeThickness="1">
            <VerticalStackLayout Spacing="5">
              <Label Text="{Binding [RoutingBuiltInDirectTitle], Source={x:Static loc:UiStrings.Instance}}" FontAttributes="Bold" FontSize="13"/>
              <Label x:Name="BuiltInDirectRuleSummary" FontSize="12" LineBreakMode="WordWrap"/>
            </VerticalStackLayout>
          </Border>
          <Border Grid.Row="1" Grid.Column="1" Padding="12" StrokeShape="RoundRectangle 9"
                  Stroke="{AppThemeBinding Light=#DBE5F1, Dark=#40516B}" StrokeThickness="1">
            <VerticalStackLayout Spacing="5">
              <Label Text="{Binding [RoutingBuiltInBypassCnTitle], Source={x:Static loc:UiStrings.Instance}}" FontAttributes="Bold" FontSize="13"/>
              <Label x:Name="BuiltInBypassCnRuleSummary" FontSize="12" LineBreakMode="WordWrap"/>
            </VerticalStackLayout>
          </Border>
        </Grid>
        <Label Text="{Binding [RoutingBuiltInJsonLabel], Source={x:Static loc:UiStrings.Instance}}"
               Style="{StaticResource FieldLabelStyle}"/>
        <Picker x:Name="BuiltInRouteDetailPicker" ItemDisplayBinding="{Binding Label}"
                AutomationId="builtin-route-detail-picker" SelectedIndexChanged="BuiltInRouteDetailChanged"
                HorizontalOptions="Fill"/>
        <Editor x:Name="BuiltInRouteJsonPreview" IsReadOnly="True" HeightRequest="185"
                Placeholder="{Binding [RoutingBuiltInJsonPlaceholder], Source={x:Static loc:UiStrings.Instance}}"
                FontFamily="{StaticResource AppCodeFontFamily}" FontSize="12"
                AutomationId="builtin-route-json-readonly"/>
        <Label x:Name="BuiltInRouteJsonFormatLabel" Style="{StaticResource HintLabelStyle}"/>
        <Label Text="{Binding [RoutingBuiltInReadonly], Source={x:Static loc:UiStrings.Instance}}"
               Style="{StaticResource HintLabelStyle}"/>
        <Label Text="{Binding [RoutingManagedPacOnly], Source={x:Static loc:UiStrings.Instance}}"
               Style="{StaticResource HintLabelStyle}"/>
      </VerticalStackLayout>
    </Border>
    <VerticalStackLayout x:Name="CustomRouterPanel" Spacing="12" IsVisible="True">
      <Label Text="{Binding [RoutingCustomDraftsTitle], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource SectionTitleStyle}"/>
      <!-- The set name is deliberately at the top, before priority and rule fields. -->
      <Grid ColumnDefinitions="*,*,192" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="4">
        <Label Grid.Row="0" Grid.Column="0" Text="{Binding [FieldRouteRuleSet], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource FieldLabelStyle}"/>
        <Label Grid.Row="0" Grid.Column="1" Text="{Binding [FieldRouteSetName], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource FieldLabelStyle}"/>
        <Label Grid.Row="0" Grid.Column="2" Text="{Binding [FieldRoutingDomainStrategy], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource FieldLabelStyle}"/>
        <Picker Grid.Row="1" Grid.Column="0" x:Name="RulePicker" HorizontalOptions="Fill" ItemDisplayBinding="{Binding Name}" SelectedIndexChanged="RulePickerChanged" AutomationId="route-ruleset-picker"/>
        <Entry Grid.Row="1" Grid.Column="1" x:Name="RuleNameEntry" Placeholder="{Binding [PlaceholderRouteSetName], Source={x:Static loc:UiStrings.Instance}}"/>
        <Picker Grid.Row="1" Grid.Column="2" x:Name="RouteStrategyPicker" WidthRequest="188" HorizontalOptions="Start" SelectedIndexChanged="RouteStrategyChanged" AutomationId="dns-strategy-picker"/>
      </Grid>
      <Label Text="{Binding [HelpDomainStrategy], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource HintLabelStyle}"/>
      <Label Text="{Binding [HelpRoutingEditorNotApplied], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource HintLabelStyle}"/>
      <FlexLayout Direction="Row" Wrap="Wrap" AlignItems="Center">
        <Button Margin="0,0,6,6" Text="{Binding [ActionNewRouteSet], Source={x:Static loc:UiStrings.Instance}}" Clicked="AddRuleClicked" Style="{StaticResource PrimaryButtonStyle}" ImageSource="action_plus_primary.png" ContentLayout="Left,6"/>
        <Button Margin="0,0,6,6" Text="{Binding [ActionSaveRouteSet], Source={x:Static loc:UiStrings.Instance}}" Clicked="SaveRuleClicked" Style="{StaticResource SmallButtonStyle}" ImageSource="action_save_neutral.png" ContentLayout="Left,6"/>
        <Button Margin="0,0,6,6" Text="{Binding [ActionDeleteRouteSet], Source={x:Static loc:UiStrings.Instance}}" Clicked="DeleteRuleClicked" Style="{StaticResource SmallButtonStyle}" ImageSource="action_delete_neutral.png" ContentLayout="Left,6"/>
      </FlexLayout>
      <Label x:Name="RouteEmptyStateLabel" Text="{Binding [RoutingNoRuleSet], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource HintLabelStyle}"/>
      <VerticalStackLayout x:Name="VisualRouteEditor" Spacing="10" IsVisible="False">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <VerticalStackLayout Spacing="4">
            <Label Text="{Binding [RoutingStep2], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource SectionTitleStyle}"/>
            <Label Text="{Binding [RoutingRulePriorityHelp], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource HintLabelStyle}"/>
          </VerticalStackLayout>
          <Button Grid.Column="1" Text="{Binding [ActionAddVisualRule], Source={x:Static loc:UiStrings.Instance}}" Clicked="AddVisualRuleClicked" Style="{StaticResource PrimaryButtonStyle}" VerticalOptions="Center" AutomationId="new-route-rule" ImageSource="action_plus_primary.png" ContentLayout="Left,6"/>
        </Grid>
        <CollectionView x:Name="VisualRuleList" HeightRequest="162" SelectionMode="Single" SelectionChanged="VisualRuleSelectionChanged" AutomationId="visual-routing-rules">
          <CollectionView.ItemTemplate>
            <DataTemplate>
              <Border Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#40516B}" StrokeThickness="1" StrokeShape="RoundRectangle 8" Margin="0,2" Padding="8,9">
                <Label Text="{Binding .}" FontSize="13" LineBreakMode="TailTruncation"/>
              </Border>
            </DataTemplate>
          </CollectionView.ItemTemplate>
        </CollectionView>
        <Label x:Name="RouteListEmptyLabel" Text="{Binding [RoutingNoRulesNext], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource HintLabelStyle}"/>
        <VerticalStackLayout x:Name="RouteDetailPanel" Spacing="10" IsVisible="False">
          <Label Text="{Binding [RoutingStep3], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource SectionTitleStyle}"/>
          <Label x:Name="RouteDraftHelpLabel" Text="{Binding [RoutingNewRuleDraft], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource HintLabelStyle}" IsVisible="False"/>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="9">
            <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
              <Label Text="{Binding [FieldRoutingOutbound], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource FieldLabelStyle}"/>
              <Picker x:Name="RouteTargetPicker" ItemDisplayBinding="{Binding Label}" AutomationId="route-outbound-picker"/>
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="4">
              <Label Text="{Binding [FieldRoutingNetwork], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource FieldLabelStyle}"/>
              <Picker x:Name="RouteNetworkPicker"/>
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="4">
              <Label Text="{Binding [FieldRoutingDomains], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource FieldLabelStyle}"/>
              <Label Text="{Binding [HelpRoutingDomains], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource HintLabelStyle}"/>
              <Editor x:Name="RouteDomainsEditor" HeightRequest="104" Placeholder="{Binding [PlaceholderRoutingDomains], Source={x:Static loc:UiStrings.Instance}}"/>
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="4">
              <Label Text="{Binding [FieldRoutingIps], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource FieldLabelStyle}"/>
              <Label Text="{Binding [HelpRoutingIps], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource HintLabelStyle}"/>
              <Editor x:Name="RouteIpsEditor" HeightRequest="104" Placeholder="{Binding [PlaceholderRoutingIps], Source={x:Static loc:UiStrings.Instance}}"/>
            </VerticalStackLayout>
          </Grid>
          <Label Text="{Binding [HelpRoutingAndConditions], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource HintLabelStyle}"/>
          <VerticalStackLayout Spacing="3">
            <Label Text="{Binding [FieldRoutingPorts], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource FieldLabelStyle}"/>
            <Entry x:Name="RoutePortsEntry" Placeholder="{Binding [PlaceholderRoutingPorts], Source={x:Static loc:UiStrings.Instance}}"/>
          </VerticalStackLayout>
          <FlexLayout Direction="Row" Wrap="Wrap" AlignItems="Center">
            <Button x:Name="SaveVisualRuleButton" Margin="0,0,6,6" Text="{Binding [ActionApplyVisualRule], Source={x:Static loc:UiStrings.Instance}}" Clicked="ApplyVisualRuleClicked" Style="{StaticResource PrimaryButtonStyle}" ImageSource="action_check_primary.png" ContentLayout="Left,6"/>
            <Button x:Name="MoveRuleUpButton" Margin="0,0,6,6" Text="{Binding [ActionMoveRuleUp], Source={x:Static loc:UiStrings.Instance}}" Clicked="MoveVisualRuleUpClicked" Style="{StaticResource SmallButtonStyle}" ImageSource="action_arrow_up_neutral.png" ContentLayout="Left,6"/>
            <Button x:Name="MoveRuleDownButton" Margin="0,0,6,6" Text="{Binding [ActionMoveRuleDown], Source={x:Static loc:UiStrings.Instance}}" Clicked="MoveVisualRuleDownClicked" Style="{StaticResource SmallButtonStyle}" ImageSource="action_arrow_down_neutral.png" ContentLayout="Left,6"/>
            <Button x:Name="DeleteVisualRuleButton" Margin="0,0,6,6" Text="{Binding [ActionRemoveVisualRule], Source={x:Static loc:UiStrings.Instance}}" Clicked="RemoveVisualRuleClicked" Style="{StaticResource SmallButtonStyle}" ImageSource="action_delete_neutral.png" ContentLayout="Left,6"/>
          </FlexLayout>
        </VerticalStackLayout>
        <Label Text="{Binding [HelpVisualRoutingSave], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource HintLabelStyle}"/>
      </VerticalStackLayout>
      <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
        <Label Text="{Binding [ToggleEditRawRouting], Source={x:Static loc:UiStrings.Instance}}" VerticalOptions="Center"/>
        <Switch x:Name="RouteRawModeSwitch" Toggled="RouteRawModeToggled" Scale="0.8" VerticalOptions="Center"/>
      </HorizontalStackLayout>
      <Editor x:Name="RoutingJsonEditor" IsVisible="False" Placeholder="{Binding [PlaceholderRouteJson], Source={x:Static loc:UiStrings.Instance}}" AutoSize="TextChanges" HeightRequest="220" FontSize="13"/>
    </VerticalStackLayout>
  </VerticalStackLayout>
</Border>

<Label Text="{Binding [SectionCustomConfig], Source={x:Static loc:UiStrings.Instance}}" FontAttributes="Bold" FontSize="17" Margin="0,10,0,3"/>
<Grid ColumnDefinitions="48,*" ColumnSpacing="4"><Switch Grid.Column="0" HorizontalOptions="Start" Scale="0.84" x:Name="UseCustomSwitch" Toggled="CustomConfigToggled"/><Label Grid.Column="1" Text="{Binding [ToggleUseCustomConfig], Source={x:Static loc:UiStrings.Instance}}" VerticalOptions="Center"/></Grid>
<Label x:Name="CustomConfigLabel" FontSize="13" TextColor="#637891"/>
<FlexLayout Direction="Row" Wrap="Wrap" AlignItems="Center"><Button Margin="0,0,8,8" Text="{Binding [ActionPickJsonFile], Source={x:Static loc:UiStrings.Instance}}" Clicked="PickCustomClicked" ImageSource="action_folder_open_neutral.png" ContentLayout="Left,6"/><Button Margin="0,0,8,8" Text="{Binding [ActionValidateConfig], Source={x:Static loc:UiStrings.Instance}}" Clicked="TestClicked" ImageSource="action_check_circle_neutral.png" ContentLayout="Left,6"/></FlexLayout>
</VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
      </Border>
    </Grid>
    <!-- Fixed bottom connection controls and diagnostic output. -->
    <Border Grid.Row="2" Grid.ColumnSpan="2" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#172233}" Stroke="{AppThemeBinding Light=#DFE7F1, Dark=#334155}" StrokeThickness="1">
      <Grid Padding="20,10" RowDefinitions="*,Auto" RowSpacing="7">
        <!-- The log panel has no duplicate connection/config actions or status text.
             Global connection and config preview remain in the top toolbar; the
             server-scoped config check lives beside Clone and Delete. -->
        <!-- Always-visible vertical scrollbar; the newest entry is at the bottom. -->
        <ScrollView x:Name="LogScrollView" Grid.Row="0" Orientation="Vertical"
                    VerticalScrollBarVisibility="Always" AutomationId="runtime-log"
                    BackgroundColor="{AppThemeBinding Light=#F6F9FD, Dark=#0F172A}">
          <VerticalStackLayout Padding="8,5" Spacing="0">
            <Label x:Name="LogTextLabel" Text="" FontFamily="{StaticResource AppCodeFontFamily}"
                   FontSize="12" LineBreakMode="CharacterWrap"/>
            <BoxView x:Name="LogTailAnchor" HeightRequest="1" Opacity="0"/>
          </VerticalStackLayout>
        </ScrollView>
        <!-- Three-zone bottom status bar: configured ports on the left, live proxy traffic
             in the true horizontal center, and the active runtime mode on the right.
             This is layout-only: sampling, label bindings, and core behavior are unchanged. -->
        <Grid Grid.Row="1" ColumnDefinitions="*,2*,*" ColumnSpacing="14" MinimumHeightRequest="35">
          <Label x:Name="ConfiguredPortsFooterLabel" Grid.Column="0" Text="" FontSize="11"
                 TextColor="{AppThemeBinding Light=#536780, Dark=#BBCBDD}"
                 LineBreakMode="TailTruncation" MaxLines="1" VerticalOptions="Center"/>
          <!-- A single compact line: rates, session totals and any unavailable state.
               The center zone is width-constrained so totals truncate instead of wrapping. -->
          <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10"
                HorizontalOptions="Fill" VerticalOptions="Center" MinimumHeightRequest="20">
            <HorizontalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
              <Label Text="↑" FontAttributes="Bold" FontSize="13" TextColor="#D08A36" VerticalOptions="Center"/>
              <Label x:Name="UploadSpeedLabel" Text="—" FontSize="11" VerticalOptions="Center"
                     MaxLines="1" LineBreakMode="NoWrap" AutomationId="traffic-upload-speed"/>
            </HorizontalStackLayout>
            <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
              <Label Text="↓" FontAttributes="Bold" FontSize="13" TextColor="#3183D9" VerticalOptions="Center"/>
              <Label x:Name="DownloadSpeedLabel" Text="—" FontSize="11" VerticalOptions="Center"
                     MaxLines="1" LineBreakMode="NoWrap" AutomationId="traffic-download-speed"/>
            </HorizontalStackLayout>
            <Label Grid.Column="2" x:Name="TrafficTotalsLabel" Text="" FontSize="11" MaxLines="1"
                   LineBreakMode="TailTruncation" HorizontalTextAlignment="Center"
                   VerticalOptions="Center" HorizontalOptions="Fill"
                   TextColor="{AppThemeBinding Light=#536780, Dark=#BBCBDD}"
                   AutomationId="traffic-session-totals"/>
            <Label Grid.Column="3" x:Name="TrafficAvailabilityLabel" Text="" FontSize="11"
                   MaxLines="1" LineBreakMode="TailTruncation"
                   TextColor="{AppThemeBinding Light=#64748B, Dark=#CBD5E1}" VerticalOptions="Center"/>
          </Grid>
          <Label Grid.Column="2" x:Name="RunningModeFooterLabel" Text=""
                 FontSize="11" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="End"
                 LineBreakMode="TailTruncation" MaxLines="1"
                 TextColor="{AppThemeBinding Light=#277454, Dark=#8CD5B4}"/>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</ContentPage>
