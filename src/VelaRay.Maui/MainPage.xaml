    </Grid>
    <VerticalStackLayout Spacing="4"><Label Text="{Binding [FieldMuxConcurrency], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource FieldLabelStyle}"/><Entry x:Name="MuxEntry" Placeholder="{Binding [PlaceholderMuxConcurrency], Source={x:Static loc:UiStrings.Instance}}" Keyboard="Numeric"/></VerticalStackLayout>
