<Border x:Name="SocketOptionsPanel" Style="{StaticResource InnerCardStyle}">
  <VerticalStackLayout Spacing="8">
    <Label Text="{Binding [SectionConnectionOptions], Source={x:Static loc:UiStrings.Instance}}" Style="{StaticResource SectionTitleStyle}"/>
    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
      <Grid Grid.Column="0" ColumnDefinitions="48,*" ColumnSpacing="4"><Switch Grid.Column="0" x:Name="TcpFastOpenSwitch" Scale="0.84" HorizontalOptions="Start"/><Label Grid.Column="1" Text="{Binding [ToggleTcpFastOpen], Source={x:Static loc:UiStrings.Instance}}" VerticalOptions="Center"/></Grid>
